# .env example for RealtyVoice AI
# Set DATABASE_URL to override the default SQLite location.
# Example (default):
# DATABASE_URL=sqlite+pysqlite:///H:/RealtyVoice-AI/data/realtyvoice.db

DATABASE_URL=
# LLM provider configuration
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30

# Agent configuration
AGENT_MAX_TOOL_ITERATIONS=4

# Application settings
DEBUG=false
LOG_LEVEL=INFO

# CORS: comma-separated allowed origins, scheme://host[:port], no wildcard
# (default: http://localhost:8000). Set this to your real origin in production.
CORS_ORIGINS=http://localhost:8000
# Cookies are not used, so credentials stay off unless you need them.
CORS_ALLOW_CREDENTIALS=false

# Logging: json (default, one object per line) or text (easier to read locally)
LOG_FORMAT=json

# Rate limiting, per client per minute (in-memory, per worker process)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AGENT_PER_MINUTE=30
RATE_LIMIT_VOICE_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Only set true behind a reverse proxy you control (trusts X-Forwarded-For)
TRUST_PROXY_HEADERS=false

# Request body limits in bytes
MAX_JSON_BODY_BYTES=65536
MAX_AUDIO_UPLOAD_BYTES=10485760

# Sarvam AI — voice (STT: Saaras v4, TTS: Bulbul v4 Flash)
# Sign up at https://docs.sarvam.ai
SARVAM_API_KEY=

# Mappls (MapMyIndia) — location and amenity search
# Sign up at https://apis.mappls.com
MAPPLS_API_KEY=

# API.SH — live property listings (relays 99acres data; not an official 99acres API)
# Not wired into the agent yet. Keep the key here only; never commit it.
APISH_API_KEY=
APISH_BASE_URL=https://api.api.sh/99acres/v1
APISH_TIMEOUT_SECONDS=15
# Credits one conversation may spend on live searches (0 disables them).
# Initial policy, to be confirmed against the API.SH plan.
LIVE_CREDITS_PER_CONVERSATION=3